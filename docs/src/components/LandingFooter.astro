---
const url = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/u, "")}/${path}`;
---

<footer class="yt-tiles not-content" aria-labelledby="yt-footer-title">
  <div class="yt-tile yt-tile-statement">
    <h2 id="yt-footer-title">A DisTube fork of ytdl-core.</h2>
    <p>MIT licence. Originally fent/node-ytdl-core and its contributors.</p>
  </div>
  <nav class="yt-tile yt-tile-nav" aria-label="Documentation">
    <a href={url("getting-started/")}>Getting started</a>
    <a href={url("guides/download/")}>Guides</a>
    <a href={url("api/readme/")}>API reference</a>
    <a href="https://www.npmjs.com/package/@distube/ytdl-core">npm</a>
  </nav>
  <div class="yt-tile yt-tile-runtime">
    <p>Runs on</p>
    <p><strong>Node.js 22.12+ and Bun</strong></p>
  </div>
  <div class="yt-tile yt-tile-support">
    <p>Keeps it going</p>
    <a href="https://ko-fi.com/skick">Support on Ko-fi</a>
  </div>
  <div class="yt-tile yt-tile-mark" aria-hidden="true">ytdl-core</div>
  <a class="yt-tile yt-tile-star" href="https://github.com/distubejs/ytdl-core">
    <span>Star it on GitHub</span>
    <svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true">
      <path d="M10 38 38 10M16 10h22v22" fill="none" stroke="currentColor" stroke-width="4"></path>
    </svg>
  </a>
</footer>

<style>
  .yt-tiles {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 8px;
    padding: 8px;
    background: var(--yt-bg);
    font-family: var(--yt-text);
    font-size: var(--step-body);
    line-height: 1.5;
  }

  .yt-tile {
    min-height: 220px;
    padding: 1.25rem;
    border-radius: 12px;
    background: var(--yt-surface);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    color: var(--yt-ink);
  }

  .yt-tile p {
    margin: 0;
  }

  .yt-tile-statement {
    grid-column: span 4;
  }

  .yt-tile-statement h2 {
    margin: 0;
    color: var(--yt-ink);
    font: 600 var(--step-lead) / 1.25 var(--yt-text);
  }

  .yt-tile-statement p,
  .yt-tile-runtime p:first-child,
  .yt-tile-support p {
    color: var(--yt-muted);
    font-size: 1rem;
  }

  .yt-tile-nav {
    grid-column: span 3;
    justify-content: flex-start;
    gap: 0.5rem;
  }

  .yt-tile a {
    color: var(--yt-ink);
    text-decoration: none;
    transition: color 160ms var(--yt-ease);
  }

  .yt-tile-nav a:hover,
  .yt-tile-support a:hover {
    color: var(--yt-accent-text);
  }

  .yt-tile-runtime {
    grid-column: span 2;
  }

  .yt-tile-support {
    grid-column: span 3;
  }

  .yt-tile-support a {
    font-size: var(--step-lead);
    font-weight: 600;
  }

  .yt-tile-mark {
    grid-column: span 8;
    min-height: 320px;
    background: var(--yt-ink);
    color: var(--yt-bg);
    font: 700 var(--step-display) / 1 var(--yt-display);
    letter-spacing: -0.04em;
    justify-content: center;
    align-items: center;
  }

  .yt-tile-star {
    grid-column: span 4;
    min-height: 320px;
    background: var(--yt-accent);
    color: var(--yt-accent-ink) !important;
    font-size: var(--step-lead);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms var(--yt-ease);
  }

  .yt-tile-star svg {
    align-self: flex-end;
    transition: transform 300ms var(--yt-ease);
  }

  .yt-tile-star:hover {
    background: #b80024;
  }

  .yt-tile-star:hover svg {
    transform: translate(6px, -6px);
  }

  .yt-tile-star:focus-visible,
  .yt-tile a:focus-visible {
    outline: 3px solid var(--yt-accent-text);
    outline-offset: 3px;
  }

  @media (max-width: 50rem) {
    .yt-tiles {
      grid-template-columns: 1fr 1fr;
      gap: 6px;
    }

    .yt-tile-mark,
    .yt-tile-star {
      grid-column: span 2;
      min-height: 160px;
    }

    .yt-tile-mark {
      order: -3;
    }

    .yt-tile-star {
      order: -2;
    }

    .yt-tile-nav {
      order: -1;
    }

    .yt-tile-nav,
    .yt-tile-support,
    .yt-tile-runtime,
    .yt-tile-statement {
      grid-column: span 1;
    }

    .yt-tile-runtime,
    .yt-tile-statement {
      order: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .yt-tile-star svg {
      transition: none;
    }
  }
</style>
