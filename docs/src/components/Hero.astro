---
import { chooseFormat } from "../../../src/formats.ts";
import { Filter, Quality } from "../../../src/types.ts";
import { formats, video } from "../data/big-buck-bunny.ts";
import { formatKey, formatLabel, megabytes } from "../data/format-label.ts";

const url = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/u, "")}/${path}`;
const chosen = chooseFormat(formats);
const length = `${Math.floor(video.lengthSeconds / 60)}:${String(video.lengthSeconds % 60).padStart(2, "0")}`;
const qualities = Object.entries(Quality);
const filters: [string, string][] = [["Any", ""], ...Object.entries(Filter)];
const spaced = (name: string) => name.replace(/(?<=[a-z])(?=[A-Z])/gu, " ").toLowerCase().replace(/^./u, (c) => c.toUpperCase());
---

<section class="yt-hero" aria-labelledby="_top">
  <div class="yt-hero-copy">
    <h1 id="_top" data-page-title>
      <span class="yt-line"><span>YouTube downloads</span></span>
      <span class="yt-line"><span>for Node.js</span></span>
    </h1>
    <p class="yt-hero-lead">
      Read a video's details and every format, then stream the one you want. Signatures are solved on your
      machine.
    </p>
    <div class="yt-hero-actions">
      <a class="yt-button" href={url("getting-started/")}>Download your first video</a>
      <a class="yt-link" href={url("api/readme/")}>API reference</a>
    </div>
    <div class="yt-hero-install">
      <pre><code>npm install @distube/ytdl-core</code></pre>
      <pre><code>bun add @distube/ytdl-core</code></pre>
    </div>
  </div>

  <div class="yt-hero-stage">
    <form class="yt-picker" data-ui aria-label="Format picker">
      <div class="yt-picker-video">
        <strong>{video.title}</strong>
        <span>{video.author} · {length} · {formats.length} formats</span>
      </div>
      <fieldset>
        <legend>quality</legend>
        {
          qualities.map(([name, value], i) => (
            <label>
              <input type="radio" name="quality" value={value} checked={i === 0} />
              <span>{spaced(name)}</span>
            </label>
          ))
        }
      </fieldset>
      <fieldset>
        <legend>filter</legend>
        {
          filters.map(([name, value], i) => (
            <label>
              <input type="radio" name="filter" value={value} checked={i === 0} />
              <span>{spaced(name)}</span>
            </label>
          ))
        }
      </fieldset>
      <pre class="yt-picker-code"><code>yt.download(info, {"{"} <span data-code>quality: Quality.Highest</span> {"}"})</code></pre>
      <output class="yt-picker-result" data-result>
        itag {chosen.itag} · {formatLabel(chosen)} · {megabytes(chosen)}
      </output>
      <ol class="yt-picker-formats" data-formats>
        {
          formats.map((format) => (
            <li data-key={formatKey(format)} aria-current={formatKey(format) === formatKey(chosen) ? "true" : undefined}>
              <span>{format.itag}</span>
              <span>{formatLabel(format)}</span>
              <span>{megabytes(format)}</span>
            </li>
          ))
        }
      </ol>
    </form>
  </div>
</section>

<script>
  import { chooseFormat } from "../../../src/formats.ts";
  import { Filter, Quality } from "../../../src/types.ts";
  import { YtdlError } from "../../../src/errors.ts";
  import { formats } from "../data/big-buck-bunny.ts";
  import { formatKey, formatLabel, megabytes } from "../data/format-label.ts";

  const form = document.querySelector<HTMLFormElement>(".yt-picker");
  const code = form?.querySelector("[data-code]");
  const result = form?.querySelector("[data-result]");
  const list = form?.querySelector<HTMLElement>("[data-formats]");
  const nameOf = (values: Record<string, string>, value: string | undefined) =>
    Object.entries(values).find(([, v]) => v === value)?.[0];

  function update() {
    if (!form || !code || !result || !list) return;
    const data = new FormData(form);
    const quality = Object.values(Quality).find((value) => value === data.get("quality"));
    const filter = Object.values(Filter).find((value) => value === data.get("filter"));
    const filterName = nameOf(Filter, filter);
    code.textContent = [
      `quality: Quality.${nameOf(Quality, quality) ?? "Highest"}`,
      ...(filterName ? [`filter: Filter.${filterName}`] : []),
    ].join(", ");
    for (const row of list.children) row.removeAttribute("aria-current");
    try {
      const chosen = chooseFormat(formats, { quality, filter });
      result.textContent = `itag ${chosen.itag} · ${formatLabel(chosen)} · ${megabytes(chosen)}`;
      result.removeAttribute("data-error");
      const row = list.querySelector<HTMLElement>(`[data-key="${formatKey(chosen)}"]`);
      row?.setAttribute("aria-current", "true");
      if (row) list.scrollTo({ top: row.offsetTop - list.clientHeight / 2 + row.clientHeight / 2, behavior: "smooth" });
    } catch (error) {
      if (!(error instanceof YtdlError)) throw error;
      result.textContent = `YtdlError ${error.code}: no format matches`;
      result.setAttribute("data-error", "");
    }
  }

  form?.addEventListener("change", update);
  form?.addEventListener("submit", (event) => event.preventDefault());
  update();
</script>

<style>
  .yt-hero {
    display: grid;
    grid-template-columns: 7fr 5fr;
    grid-template-rows: minmax(0, 1fr);
    height: max(42rem, calc(100svh - var(--sl-nav-height)));
    background: var(--yt-bg);
  }

  .yt-hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--yt-margin);
    gap: 2rem;
  }

  .yt-hero-install {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    animation: yt-fade 700ms 500ms var(--yt-ease) both;
  }

  .yt-hero-install pre {
    margin: 0;
    padding: 0.875rem 1.25rem;
    border-radius: 8px;
    background: var(--yt-surface);
    font-size: 1rem;
  }

  .yt-hero h1 {
    font-size: var(--step-display);
  }

  .yt-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .yt-line > span {
    display: block;
    animation: yt-line 900ms var(--yt-ease) both;
  }

  .yt-line + .yt-line > span {
    animation-delay: 110ms;
  }

  @keyframes yt-line {
    from {
      transform: translateY(105%);
    }
  }

  .yt-hero-lead {
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: 34ch;
    animation: yt-fade 700ms 400ms var(--yt-ease) both;
  }

  .yt-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    white-space: nowrap;
    animation: yt-fade 700ms 400ms var(--yt-ease) both;
  }

  @keyframes yt-fade {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .yt-hero-stage {
    background: var(--yt-surface);
    display: grid;
    place-items: center end;
    padding: var(--yt-margin);
  }

  .yt-picker {
    width: min(100%, 36rem);
    display: grid;
    gap: 1rem;
    font-size: 1rem;
    color: var(--yt-ink);
  }

  .yt-picker-video {
    display: grid;
    gap: 0.25rem;
  }

  .yt-picker-video strong {
    font-size: 1rem;
    font-weight: 600;
  }

  .yt-picker-video span,
  .yt-picker legend {
    color: var(--yt-muted);
  }

  .yt-picker fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .yt-picker legend {
    padding: 0 0 0.5rem;
  }

  .yt-picker label {
    position: relative;
    cursor: pointer;
  }

  .yt-picker input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .yt-picker label span {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border-radius: 8px;
    background: var(--yt-surface-2);
    transition:
      background-color 160ms var(--yt-ease),
      transform 160ms var(--yt-ease);
  }

  .yt-picker label:hover span {
    background: color-mix(in srgb, var(--yt-surface-2), var(--yt-ink) 12%);
  }

  .yt-picker label:active span {
    transform: scale(0.96);
  }

  .yt-picker input:checked + span {
    background: var(--yt-ink);
    color: var(--yt-bg);
    font-weight: 600;
  }

  .yt-picker input:focus-visible + span {
    outline: 3px solid var(--yt-accent-text);
    outline-offset: 2px;
  }

  .yt-picker-code {
    margin: 0;
    padding: 0.875rem 1rem;
    border-radius: 8px;
    background: var(--yt-bg);
    overflow-x: auto;
    font-size: 1rem;
  }

  .yt-picker-result {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .yt-picker-result[data-error] {
    color: var(--yt-accent-text);
  }

  .yt-picker-formats {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 15.5rem;
    overflow-y: auto;
    position: relative;
    border-radius: 8px;
    background: var(--yt-bg);
    font-variant-numeric: tabular-nums;
  }

  .yt-picker-formats li {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    gap: 1rem;
    padding: 0.4rem 1rem;
    color: var(--yt-muted);
    transition:
      background-color 200ms var(--yt-ease),
      color 200ms var(--yt-ease);
  }

  .yt-picker-formats li[aria-current] {
    background: var(--yt-accent);
    color: var(--yt-accent-ink);
    font-weight: 600;
  }

  @media (max-width: 50rem) {
    .yt-hero {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      height: auto;
    }

    .yt-picker {
      width: 100%;
    }

    .yt-picker-formats li {
      grid-template-columns: 2.5rem 1fr auto;
      gap: 0.75rem;
      padding-inline: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .yt-line > span,
    .yt-hero-lead,
    .yt-hero-actions,
    .yt-hero-install {
      animation: none;
    }
  }
</style>
