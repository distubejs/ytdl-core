{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist", "coverage", "tests/fixtures"],
  "rules": {
    "unicorn/require-post-message-target-origin": "off"
  }
}
