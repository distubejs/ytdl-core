{
  "name": "@distube/ytdl-core",
  "version": "5.1.3",
  "description": "YouTube video info and downloads for Node.js, with local player solving and resumable streams.",
  "keywords": [
    "audio",
    "distube",
    "download",
    "video",
    "youtube"
  ],
  "homepage": "https://distube.js.org/ytdl-core/",
  "bugs": {
    "url": "https://github.com/distubejs/ytdl-core/issues"
  },
  "license": "MIT",
  "author": "Skick (https://github.com/skick1234)",
  "contributors": [
    "fent <fentbox@gmail.com> (https://github.com/fent)",
    "Tobias Kutscha (https://github.com/TimeForANinja)",
    "Andrew Kelley (https://github.com/andrewrk)",
    "Mauricio Allende (https://github.com/mallendeo)",
    "Rodrigo Altamirano (https://github.com/raltamirano)",
    "Jim Buck (https://github.com/JimmyBoh)",
    "Pawel Rucinski (https://github.com/Roki100)",
    "Alexander Paolini (https://github.com/Million900o)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/distubejs/ytdl-core.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "type": "tsrs --noEmit",
    "test": "bun test ./tests",
    "test:live": "YTDL_LIVE=1 bun test ./tests/live --timeout 300000",
    "build": "rm -rf dist && tsrs -p tsconfig.build.json",
    "check:node": "bun run build && node --expose-gc scripts/check-node.mjs",
    "verify": "bun run check && bun run type && bun run test && bun run check:node",
    "prepack": "bun run build"
  },
  "dependencies": {
    "bgutils-js": "^4.0.3",
    "googlevideo": "^5.0.0",
    "jsdom": "^30.1.3",
    "meriyah": "^7.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
